node_modules/
dist/
.next/
.env
.env.local
*.tsbuildinfo
.DS_Store
coverage/
.vercel
.env*

# large regenerable data snapshots (via scripts/snapshot.mjs)
data/

# scratch scripts from interactive sessions
scripts/.tmp-*

# local-only research: recordings, transcripts, posting notes
research/

# daily output of the content routine (docs/CONTENT-ROUTINE.md) — regenerated
# every morning, so tracking it means a dirty tree every day
docs/programs/

# the writing itself: post drafts and their diagrams. This is Ash's work in
# progress, not the project's source — an unpublished draft has no business in
# a public repo, and leaving it untracked next to code is how it ends up there.
# docs/ keeps the project documents (SPEC, VISION, ROADMAP, CONTENT-ROUTINE);
# everything about a specific program or post stays local.
docs/posts/
docs/diagrams/

# local experiments — build artifacts and keypairs, never publish
experiments/

# Skills installed from someone else's repo (currently simple-english, an
# ASD-STE100 technical-writing rulebook). They change how an agent writes prose
# here; they are not part of On Record and nothing in the app imports them.
# Vendored code, so treated like node_modules — kept local, never committed.
# skills-lock.json records where they came from; that stays local too, so a
# fresh install never shows up as 400-odd uncommitted lines again.
.agents/
skills-lock.json
.claude/skills/simple-english
