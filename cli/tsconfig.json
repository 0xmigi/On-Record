{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "declaration": false,
    "declarationMap": false,
    // src imports use .ts so `node src/cli.ts` runs directly on Node 22.18+;
    // the build rewrites them to .js for dist
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
